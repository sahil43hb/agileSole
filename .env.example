# MongoDB — Atlas or local. For machines without Docker, keep USE_MEMORY_MONGO=true
USE_MEMORY_MONGO=true
MONGODB_URI=mongodb://127.0.0.1:27017/agilesole

# Cookie/JWT signing (use a long random string in production)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Seeded owner login (scripts/seed.ts)
SEED_ADMIN_EMAIL=agilesole@gmail.com
SEED_ADMIN_PASSWORD=Admin123
SEED_STAFF_PASSWORD=Staff123

# Gmail SMTP (use a Google App Password, not the account login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=agilesole@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=Agile Sole

# Public site URL (use the Vercel Preview/Production URL on staging)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=923069158103
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/sahil.mazeem
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/agilesole/
NEXT_PUBLIC_TIKTOK=https://www.tiktok.com/@agilesole

# Optional: Cloudinary unsigned upload (used on Vercel if set). Otherwise production
# stores images in MongoDB and serves them from /api/v1/media/:id
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=

# Optional: install IDs in Admin → Settings instead. These are not required at boot.
# GA4_MEASUREMENT_ID=G-XXXXXXXX
# META_PIXEL_ID=
